<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Capnp\.Net\.Runtime\.dll$</ModulePath>
        <ModulePath>.*CapnpC\.CSharp\.Generator\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Functions>
      <Exclude>
        <Function>^CapnpC\.CSharp\.Generator\.Schema\..*</Function>
      </Exclude>
    </Functions>
    <UseVerboseInstrumentation>false</UseVerboseInstrumentation>
  </CodeCoverage>
</Configuration>
